{
  "skill_name": "core-engineering",
  "evals": [
    {
      "id": 1,
      "prompt": "Review the attached Python function. Prioritize findings by impact, explain the attack path, and propose the smallest safe correction. Do not redesign unrelated code.",
      "expected_output": "Identify SQL injection as the critical issue, replace string interpolation with a parameterized query, mention input/trust-boundary handling, and avoid an unrelated rewrite.",
      "files": [
        "evals/fixtures/vulnerable_user_lookup.py"
      ],
      "checks": [
        {
          "id": "names-injection",
          "type": "contains_any",
          "values": [
            "SQL injection",
            "injection vulnerability"
          ]
        },
        {
          "id": "prioritizes-severity",
          "type": "contains_any",
          "values": [
            "critical",
            "blocker",
            "highest severity"
          ]
        },
        {
          "id": "uses-parameters",
          "type": "contains_any",
          "values": [
            "parameterized",
            "query parameters",
            "placeholder"
          ]
        },
        {
          "id": "explains-attack-path",
          "type": "contains_any",
          "values": [
            "attack path",
            "attacker supplies",
            "caller-controlled"
          ]
        },
        {
          "id": "provides-sqlite-binding",
          "type": "regex",
          "pattern": "execute\\s*\\([^\\n]*,\\s*\\(\\s*email\\s*,\\s*\\)"
        },
        {
          "id": "keeps-fix-minimal",
          "type": "contains_any",
          "values": [
            "minimal",
            "smallest safe",
            "smallest correction"
          ]
        },
        {
          "id": "avoids-broad-rewrite",
          "type": "not_contains",
          "value": "rewrite the entire"
        }
      ]
    },
    {
      "id": 2,
      "prompt": "Write a complete Python 3.14 command-line program that reads a local JSON array of objects and prints a count by the string field `status`. Use uv and the standard library, precise built-in type annotations, Google-style docstrings, top-level shape validation, useful errors to stderr, and an entry point that propagates the exit code. Keep the solution proportionate.",
      "expected_output": "A runnable, typed Python 3.14 program using the uv-run shebang, argparse, json, validation, explicit error handling, built-in generic types, and an if __name__ == \"__main__\" entry point without third-party dependencies.",
      "files": [],
      "checks": [
        {
          "id": "stdlib-shape",
          "type": "contains_all",
          "values": [
            "argparse",
            "json",
            "stderr",
            "__main__"
          ]
        },
        {
          "id": "validates-array",
          "type": "contains_any",
          "values": [
            "isinstance",
            "must be a list",
            "JSON array"
          ]
        },
        {
          "id": "uses-precise-built-in-generics",
          "type": "regex",
          "pattern": "(?:list|dict)\\[[^\\]\\n]+\\]"
        },
        {
          "id": "rejects-bare-dict-generics",
          "type": "not_regex",
          "pattern": "(?:list\\[dict\\]|(?:->|:)\\s*dict\\s*(?:=|\\)|,|:|$))"
        },
        {
          "id": "uses-typed-main",
          "type": "contains_all",
          "values": [
            "def main(",
            "-> int"
          ]
        },
        {
          "id": "propagates-main-exit-code",
          "type": "regex",
          "pattern": "(?:raise\\s+SystemExit\\(main\\(\\)\\)|sys\\.exit\\(main\\(\\)\\))"
        },
        {
          "id": "uses-function-docstrings",
          "type": "regex",
          "pattern": "def\\s+[a-z][a-z0-9_]*\\([^\\n]*\\)(?:\\s*->[^:]+)?:\\s*\\n\\s+\"\"\""
        },
        {
          "id": "avoids-broad-exceptions",
          "type": "not_regex",
          "pattern": "except\\s+(?:Exception|BaseException)\\b"
        },
        {
          "id": "no-pandas",
          "type": "not_regex",
          "pattern": "(?:^|\\n)\\s*(?:from|import)\\s+pandas\\b"
        },
        {
          "id": "no-cli-framework",
          "type": "not_regex",
          "pattern": "(?:^|\\n)\\s*(?:from|import)\\s+(?:click|typer)\\b"
        },
        {
          "id": "uses-uv-shebang",
          "type": "contains",
          "value": "#!/usr/bin/env -S uv run"
        },
        {
          "id": "rejects-generic-python-shebang",
          "type": "not_contains",
          "value": "#!/usr/bin/env python3"
        },
        {
          "id": "rejects-lower-python-versions",
          "type": "not_regex",
          "pattern": "Python\\s+3\\.(?:1[0-3]|[0-9])\\b|python-version\\s*:\\s*[\"']?3\\.(?:1[0-3]|[0-9])\\b"
        }
      ]
    },
    {
      "id": 3,
      "prompt": "A repository uses old actions/checkout and actions/setup-python refs. Using the attached official-release metadata, provide updated workflow refs under the default major-alias policy. This repository requires Python 3.14 and uv; do not use an older Python, pip, or requirements.txt. Treat model memory as potentially stale, cite all three supplied release sources, state when the metadata was retrieved, and use only aliases verified by the supplied metadata.",
      "expected_output": "Use the verified major aliases actions/checkout@v7, actions/setup-python@v7, and astral-sh/setup-uv@v10, with comments naming latest stable releases v7.0.1, v7.0.0, and v10.0.1. Configure Python 3.14 and uv without pip or requirements.txt, cite all official links, state the retrieval date, and explain that an explicit user request may instead select a verified exact stable tag or immutable commit SHA.",
      "files": [
        "evals/fixtures/current-action-releases.json"
      ],
      "checks": [
        {
          "id": "requires-verification",
          "type": "contains_any",
          "values": [
            "verify",
            "verified",
            "current release",
            "model memory",
            "metadata",
            "potentially stale"
          ]
        },
        {
          "id": "uses-official-source",
          "type": "contains",
          "value": "github.com/actions/checkout"
        },
        {
          "id": "uses-both-official-sources",
          "type": "contains",
          "value": "github.com/actions/setup-python"
        },
        {
          "id": "uses-verified-major-aliases",
          "type": "contains_all",
          "values": [
            "actions/checkout@v7",
            "actions/setup-python@v7"
          ]
        },
        {
          "id": "names-current-releases",
          "type": "contains_all",
          "values": [
            "v7.0.1",
            "v7.0.0",
            "v10.0.1"
          ]
        },
        {
          "id": "uses-setup-uv-official-source",
          "type": "contains",
          "value": "github.com/astral-sh/setup-uv"
        },
        {
          "id": "uses-python-3-14",
          "type": "contains",
          "value": "3.14"
        },
        {
          "id": "uses-uv",
          "type": "contains",
          "value": "uv"
        },
        {
          "id": "rejects-lower-python-versions",
          "type": "not_regex",
          "pattern": "python-version\\s*:\\s*[\"']?3\\.(?:1[0-3]|[0-9])\\b|Python\\s+3\\.(?:1[0-3]|[0-9])\\b"
        },
        {
          "id": "rejects-pip-and-requirements",
          "type": "not_regex",
          "pattern": "(?:^|\\n)\\s*(?:(?:run\\s*:\\s*)?(?:python\\s+-m\\s+)?pip(?:3)?\\s+install\\b|cache\\s*:\\s*[\"']?pip\\b)"
        },
        {
          "id": "configures-uv-in-ci",
          "type": "contains_all",
          "values": [
            "astral-sh/setup-uv@v10",
            "uv sync"
          ]
        },
        {
          "id": "allows-explicit-pinning-override",
          "type": "contains_all",
          "values": [
            "explicit user request",
            "exact stable tag",
            "immutable commit SHA"
          ]
        },
        {
          "id": "uses-least-privilege-workflow",
          "type": "regex",
          "pattern": "permissions\\s*:\\s*(?:\\{\\s*contents\\s*:\\s*read\\s*\\}|[\\s\\S]{0,80}contents\\s*:\\s*read)"
        },
        {
          "id": "rejects-unicode-dashes",
          "type": "not_regex",
          "pattern": "\\u2013|\\u2014"
        }
      ]
    },
    {
      "id": 4,
      "prompt": "A 30-line local CSV conversion script currently handles one stable format. A proposal adds plugin discovery, abstract factories, repository and service classes, dependency injection, and configuration for hypothetical future formats. Review the proposal and recommend the proportionate design.",
      "expected_output": "Reject the speculative architecture under KISS and YAGNI, retain a small functional design for the current requirement, identify concrete evidence that would justify an abstraction later, and avoid drafting the proposed class hierarchy.",
      "files": [],
      "checks": [
        {
          "id": "names-simplicity-principle",
          "type": "contains_any",
          "values": [
            "KISS",
            "YAGNI",
            "over-engineering",
            "speculative abstraction"
          ]
        },
        {
          "id": "acknowledges-current-small-scope",
          "type": "contains_any",
          "values": [
            "30-line",
            "30 line",
            "small script",
            "single stable format"
          ]
        },
        {
          "id": "recommends-current-simple-design",
          "type": "contains_any",
          "values": [
            "function",
            "functional",
            "keep it simple",
            "simplest"
          ]
        },
        {
          "id": "defines-reversal-evidence",
          "type": "contains_any",
          "values": [
            "when a second format",
            "multiple formats",
            "evidence",
            "revisit"
          ]
        },
        {
          "id": "does-not-draft-class-hierarchy",
          "type": "not_regex",
          "pattern": "class\\s+(?:Plugin|Abstract|Factory|Repository|Service)"
        }
      ]
    },
    {
      "id": 5,
      "prompt": "Review this maintenance proposal: use every package registry's `latest` alias, adopt Node Current instead of LTS, upgrade Python and Go to unreleased release candidates, remove lockfiles, and postpone compatibility tests. The team says exceptions can remain forever if upgrades are difficult. Provide the production-safe policy.",
      "expected_output": "Reject blindly latest and prereleases. Select the newest supported stable versions compatible with the repository and deployment target, verify exact releases and refs, preserve runtime/toolchain pins and lockfiles, review breaking changes, run compatibility and security checks, use staged rollout and rollback, and require exception owners and expiry dates.",
      "files": [],
      "checks": [
        {
          "id": "selects-supported-stable",
          "type": "contains_all",
          "values": [
            "supported",
            "stable",
            "compatible",
            "verify"
          ]
        },
        {
          "id": "preserves-reproducibility",
          "type": "contains_all",
          "values": [
            "pin",
            "lockfile",
            "breaking",
            "test"
          ]
        },
        {
          "id": "requires-security-and-exception-lifecycle",
          "type": "contains_all",
          "values": [
            "security",
            "owner",
            "expiry",
            "rollback"
          ]
        },
        {
          "id": "rejects-prerelease-adoption",
          "type": "contains_any",
          "values": [
            "reject",
            "do not use",
            "prerelease",
            "release candidate"
          ]
        },
        {
          "id": "rejects-unicode-dashes",
          "type": "not_regex",
          "pattern": "\\u2013|\\u2014"
        }
      ]
    },
    {
      "id": 6,
      "prompt": "Review a function that processes n orders and, for each order, linearly scans m blocked customer IDs. The lists can each contain hundreds of thousands of elements. Provide the smallest behavior-preserving correction, including precise time and auxiliary-space complexity and a measurement plan.",
      "expected_output": "Define n and m, identify current O(n * m) time and O(1) auxiliary space, build a hash set once, and perform membership tests for expected O(n + m) time with O(m) auxiliary space. Qualify hash lookup as expected rather than guaranteed worst-case O(1), preserve behavior, and propose a representative benchmark.",
      "files": [],
      "checks": [
        {
          "id": "defines-input-variables",
          "type": "contains_all",
          "values": [
            "n",
            "orders",
            "m",
            "blocked"
          ]
        },
        {
          "id": "analyzes-current-complexity",
          "type": "contains_all",
          "values": [
            "O(n * m)",
            "O(1)",
            "auxiliary"
          ]
        },
        {
          "id": "analyzes-corrected-complexity",
          "type": "contains_all",
          "values": [
            "set",
            "O(n + m)",
            "O(m)",
            "expected"
          ]
        },
        {
          "id": "requires-measurement",
          "type": "contains_any",
          "values": [
            "benchmark",
            "measure",
            "profile"
          ]
        },
        {
          "id": "observes-core-skill",
          "type": "loaded_skill",
          "skill": "core-engineering",
          "required": false
        }
      ]
    },
    {
      "id": 7,
      "prompt": "Review these claims: (1) every hash-map lookup is guaranteed O(1), (2) every dynamic-array append is O(1), and (3) two consecutive loops over n items are O(n^2). Correct each claim and explain the relevant assumptions.",
      "expected_output": "Hash lookup is commonly expected O(1), not an unconditional worst-case guarantee. Dynamic-array append is amortized O(1), while a resize can take O(n). Two consecutive O(n) loops are O(n + n), which simplifies to O(n), not O(n^2).",
      "files": [],
      "checks": [
        {
          "id": "qualifies-hash-lookup",
          "type": "contains_all",
          "values": [
            "expected O(1)",
            "worst case",
            "hash"
          ]
        },
        {
          "id": "explains-amortized-append",
          "type": "contains_all",
          "values": [
            "amortized O(1)",
            "resize",
            "O(n)"
          ]
        },
        {
          "id": "combines-sequential-loops",
          "type": "contains_all",
          "values": [
            "O(n + n)",
            "O(n)",
            "not O(n^2)"
          ]
        }
      ]
    },
    {
      "id": 8,
      "prompt": "A clear implementation scans at most 12 configuration entries once during startup. A proposal replaces it with a custom index, cache invalidation, synchronization, and background rebuilding solely to change O(n) lookup to expected O(1). Review the proposal.",
      "expected_output": "Reject the speculative optimization because n is tightly bounded and the startup path lacks a measured bottleneck. Keep the simple O(n) scan, state the small bound and lifecycle, and define profiling or latency evidence that would justify revisiting the design.",
      "files": [],
      "checks": [
        {
          "id": "rejects-notation-only-optimization",
          "type": "contains_all",
          "values": [
            "reject",
            "bounded",
            "12",
            "O(n)"
          ]
        },
        {
          "id": "keeps-simple-design",
          "type": "contains_any",
          "values": [
            "keep the simple",
            "retain the scan",
            "simple scan"
          ]
        },
        {
          "id": "requires-bottleneck-evidence",
          "type": "contains_all",
          "values": [
            "bottleneck",
            "measure",
            "revisit"
          ]
        }
      ]
    }
  ]
}
